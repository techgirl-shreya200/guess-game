import random

a=random.randint(1,100)

while True:
    userChoice=int(input("guess the number:"))
    if(userChoice == a):
        print("success:correct guess!")
        break
    elif(userChoice < a):
        print("your number was too small.take a bigger guess..")
    else:
        print("your number was too big.take a smaller guess..")
        
print("---game over---")    
        
    
